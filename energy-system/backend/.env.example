# ── Smart Energy System – environment configuration ──────────────────────────
# Copy this file to .env and fill in the values before starting in production.
# Never commit .env to version control.

# ── Application mode ─────────────────────────────────────────────────────────
# Set to "production" to enforce JWT_SECRET and stricter defaults.
ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to SQLite (./energy.db) – set DATABASE_URL for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/energy

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production – use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_HOURS=24

# ── Tariff / billing ─────────────────────────────────────────────────────────
# All monetary values derived from this are ESTIMATES, not official bills.
TARIFF_PER_KWH=7.5
BUDGET_KWH=6000

# ── Legacy device key (single shared key for /api/ingest) ────────────────────
# New devices should use the per-device key system via /api/devices.
DEVICE_KEY=esp32-demo-key

# ── Device monitoring ─────────────────────────────────────────────────────────
# Seconds without a heartbeat before a device is considered offline.
DEVICE_OFFLINE_TIMEOUT_SEC=120
# How often to run the offline checker (seconds).
DEVICE_CHECK_INTERVAL_SEC=60

